{
  "expo": {
    "name": "B&C Teranga",
    "slug": "blanchisserie-sn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "blanchisserie-sn",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blanchisserie.sn"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1A2E"
      },
      "package": "com.blanchisserie.sn",
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDpbWA7No_MklXo7Z4lSwEsn86dcRjRcy0"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1A2E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorise Blanchisserie SN à accéder à ta caméra pour scanner les QR codes clients."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise Blanchisserie SN à prendre des photos des colis lors des collectes et livraisons."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autorise Blanchisserie SN à utiliser ta position pour traçabilité des collectes/livraisons."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "447e5875-f731-4853-9668-abf2e04bc303"
      }
    }
  }
}
